# YouTube Data API v3 key (피드/라디오)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Gemini API key (AI 요약/인사이트)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 모델 ID (미설정 시 models/gemini-2.5-flash, 404 시 models/gemini-flash-latest 폴백)
# GEMINI_MODEL_ID=models/gemini-2.5-flash

# Notion 그래프 쓰기(요한 브레인 동기화) — 기본 off, 서버 전용
# Notion 통합(integration) 토큰. 미설정 시 노션 동기화 액션이 거절된다.
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 1(또는 true)일 때만 트리플/인물/개념 DB 쓰기 활성화. 미설정=off (RESOURCE/SUMMARY 동기화는 그대로 동작).
# NOTION_WRITE_GRAPH=1

# Optional: server-to-server 재검증 호출 시 사용
REVALIDATE_SECRET=your_long_random_secret_here

# Supabase project (server-side)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase project (client-side, public)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 주인(운영자) 이메일: 이 이메일로 로그인한 사용자는 플랜 제한 없이 전 기능 사용
# OWNER_EMAIL=your_email@gmail.com

# Stripe (Pro 구독 결제)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...  (Stripe Dashboard에서 Pro 월 구독 가격 ID)

# 사이트 URL (결제 성공/취소 리다이렉트, OAuth 콜백용)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 병합 피드 최대 노출 개수 (50~2000, 미설정 시 500)
# MAX_MERGED_FEED_ITEMS=500

# CI Playwright 전용 정적 피드. CI=true와 함께 설정될 때만 활성화하며 일반 배포에서는 사용하지 않습니다.
# FOCUS_FEED_E2E_FIXTURES=1

# --- 선택: Gemini 버스트 레이트 리받 (미설정 시 코드 기본값 사용)
# GEMINI_ACTIONS_PER_MINUTE=36
# GEMINI_ANON_ACTIONS_PER_MINUTE=24
# GEMINI_TREND_PER_HOUR_PER_IP=40

# 프로덕션에서만 /api/debug-youtube 를 켤 때 (기본: 비활성·404)
# ENABLE_DEBUG_YOUTUBE=true

# 프로덕션에서 /api/ops/status 조회 시 필요한 헤더 값
# OPS_STATUS_SECRET=replace_with_a_long_random_secret

# clean canary 캡처 도우미. 운영에서는 승인된 카나리 창에서만 둘 다 설정합니다.
# KNOWLEDGE_CANARY_CAPTURE_ENABLED=1
# KNOWLEDGE_CANARY_OWNER_USER_ID=00000000-0000-4000-8000-000000000000

# 로컬 작업실 초안 CLI (`npm run knowledge:draft`). 시크릿은 .env.local에만.
# FOCUS_FEED_ORIGIN=http://127.0.0.1:3000
# FOCUS_FEED_COOKIE=your_supabase_session_cookie_header
# FOCUS_FEED_DRAFT_OWNER_USER_ID=00000000-0000-4000-8000-000000000000

# 집 PC 작업실 에이전트 사이드카 (`npm run knowledge:agent`). 127.0.0.1만 listen.
# NEXT_PUBLIC_KNOWLEDGE_AGENT_URL=http://127.0.0.1:8787
# KNOWLEDGE_AGENT_PORT=8787
# 배포 사이트를 같은 PC 브라우저에서 열 때만 추가 origin.
# KNOWLEDGE_AGENT_ORIGINS=https://your-domain.com
# Optional local Brain checkout for read-only amendment approval verification.
# Leave unset on servers without the trusted local Brain CLI and its credentials.
FOCUS_FEED_BRAIN_ROOT=
# 승인 자료 활용 메모를 보관할 서버 로컬 절대경로. Git 밖의 영속 폴더를 사용한다.
# 예: C:/Users/Public/dev/_assets/focus-feed/usage-context
# 미설정 시 활용 메모는 503으로 중단한다. 서버 간 자동 동기화는 하지 않는다.
FOCUS_FEED_USAGE_ROOT=
# Local trusted yohan-mcp checkout for approved-document semantic search (Python venv + Qdrant/Ollama).
FOCUS_FEED_MCP_ROOT=
